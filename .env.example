# Copy to `.env` and fill in the keys.
# Which LLM to use. Supported: claude, openai
AI_PROVIDER=claude

# Provider API key (Anthropic or OpenAI, depending on AI_PROVIDER)
AI_API_KEY=

# Model override. Defaults per provider:
#   claude -> claude-haiku-4-5-20251001
#   openai -> gpt-4o-mini
AI_MODEL=claude-haiku-4-5-20251001
